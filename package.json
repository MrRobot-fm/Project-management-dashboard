{
  "name": "project-management-dashboard-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.5.1",
    "turbo": "^2.8.10",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.0",
      "@types/react-dom": "19.2.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "bcrypt",
      "core-js-pure",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
